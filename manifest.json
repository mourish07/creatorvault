{
  "manifest_version": 3,
  "name": "CreatorVault",
  "version": "1.0.0",
  "description": "Instagram Influencer CRM — Capture creators. Organize relationships. Build your pipeline.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CreatorVault"
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*", "assets/*", "icons/*"],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
